# Use a separate Firebase project for each deployed environment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Required in production web builds. Register the site in reCAPTCHA Enterprise
# and Firebase App Check before enabling enforcement.
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Development-only. Never set this on a production build.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false

# EAS file variables may point these to environment-specific native config files.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_INFO_PLIST=./GoogleService-Info.plist
