{
  "name": "split-patel",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:rules": "firebase emulators:exec --project split-patel-rules-test --only firestore \"jest --config jest.firestore.config.js --runInBand\"",
    "test:backend": "npm run backend:build && firebase emulators:exec --project split-patel-backend-test --only firestore \"npm --prefix functions test\"",
    "test:e2e": "npm run backend:build && firebase emulators:exec --project split-patel --only auth,firestore,functions \"bash scripts/run-e2e.sh\"",
    "test:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit",
    "backend:build": "npm --prefix functions run typecheck && npm --prefix functions run build",
    "build:web": "node scripts/check-production-env.mjs && expo export --platform web",
    "lint": "eslint app src"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/app-check": "23.4.1",
    "@react-native-firebase/auth": "^23.4.1",
    "@react-native-firebase/firestore": "^23.4.1",
    "@react-native-firebase/functions": "23.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.33.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
